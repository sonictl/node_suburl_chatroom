<!DOCTYPE html>
<html lang="zh-CN" data-theme="cupcake">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>聊天室 - <%= roomId %></title>
  <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.14/dist/full.min.css" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html {
      height: 100%;
      height: -webkit-fill-available;
      overflow: hidden;
    }
    body { 
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      position: fixed;
      width: 100%;
      overflow-x: hidden;
    }
    #chat-messages {
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
    }
    .message-bubble {
      max-width: 85%;
      word-wrap: break-word;
      word-break: break-word;
      overflow-wrap: break-word;
      white-space: pre-wrap;
      display: inline-block;
      line-height: 1.3;
      text-align: left;
      font-size: 0.9rem;
    }
    .message-wrapper {
      max-width: 100%;
      margin-bottom: 0.15rem;
    }
    .message-wrapper.message-self { text-align: right; }
    .message-wrapper.message-other { text-align: left; }
    .message-self .message-bubble {
      background-color: #c8e6c9;
      color: #1b5e20;
      border-radius: 18px 18px 4px 18px;
    }
    .message-other .message-bubble {
      background-color: #e8f5e9;
      color: #2e7d32;
      border-radius: 18px 18px 18px 4px;
    }
    .message-wrapper.message-system { align-self: center; text-align: center; }
    .message-system .message-bubble {
      background: transparent;
      color: var(--bc);
      font-style: italic;
      font-size: 0.8rem;
      max-width: 100%;
      width: auto;
      opacity: 0.6;
    }
    .message-private { border: 2px solid var(--wa) !important; }
    #typing-indicator {
      font-size: 0.8rem;
      color: var(--bc);
      opacity: 0.6;
      font-style: italic;
      min-height: 1.2rem;
    }
    .connection-status {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 0.75rem;
      white-space: nowrap;
    }
    .online-users-drawer {
      position: fixed;
      top: 0;
      right: -280px;
      width: 260px;
      max-width: 80vw;
      height: 100%;
      height: 100dvh;
      background: var(--b1);
      z-index: 1100;
      transition: right 0.3s ease;
      box-shadow: -2px 0 8px rgba(0,0,0,0.1);
      display: flex;
      flex-direction: column;
    }
    .online-users-drawer.open { right: 0; }
    .drawer-overlay {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0,0,0,0.4);
      z-index: 1050;
      display: none;
    }
    .drawer-overlay.open { display: block; }
    .online-user {
      cursor: pointer;
      padding: 8px 12px;
      border-radius: 8px;
      transition: all 0.2s;
    }
    .online-user:hover { background-color: var(--b2); }
    .online-user.self { font-weight: 600; }
    .mobile-menu-btn { display: none; }
    @media (max-width: 768px) {
      .mobile-menu-btn { display: flex; }
      .desktop-user-list { display: none !important; }
      .message-bubble { max-width: 92%; font-size: 0.85rem; }
      .main-container { width: 100vw; max-width: 100vw; overflow-x: hidden; }
      header { padding-left: 8px !important; padding-right: 8px !important; }
      header h1 { font-size: 0.875rem !important; max-width: 100px !important; }
      .input-area { padding: 6px 8px !important; }
      .input-area .flex { gap: 4px !important; }
      .input-area #emoji-btn { width: 32px; height: 32px; min-height: 32px; padding: 0; font-size: 1.1rem; }
      .input-area #send-btn { padding: 0 10px; min-height: 32px; height: 32px; font-size: 0.8rem; }
      .input-area #message-input { font-size: 0.85rem; min-height: 32px !important; padding: 6px 10px; }
      #search-box .flex { flex-wrap: nowrap; gap: 4px !important; }
      #search-box #search-input { min-width: 0; flex: 1; }
      #search-box #search-count { font-size: 0.7rem; white-space: nowrap; }
      #emoji-picker-container { left: 0; right: 0; bottom: 60px; display: none; }
      #emoji-picker-container.show { display: flex; justify-content: center; }
      #emoji-picker-container emoji-picker { width: 100%; max-width: 100vw; --num-columns: 8; --emoji-size: 1.2rem; max-height: 250px; }
    }
    @media (min-width: 769px) {
      .mobile-menu-btn, .drawer-overlay, .online-users-drawer { display: none !important; }
    }
    @media (max-width: 400px) {
      header h1 { max-width: 80px !important; font-size: 0.8rem !important; }
      #connection-status { display: none !important; }
      .input-area #emoji-btn { display: none !important; }
    }
    #nickname-modal {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      backdrop-filter: blur(4px);
    }
    #nickname-modal.hidden { display: none; }
    #emoji-picker-container {
      position: absolute;
      bottom: 70px;
      left: 10px;
      z-index: 100;
      display: none;
    }
    #emoji-picker-container.show { display: block; }
    #search-box { display: none; }
    #search-box.show { display: block; }
    #mute-modal {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      backdrop-filter: blur(4px);
    }
    #mute-modal.hidden { display: none; }
    .highlight { background-color: var(--wa); padding: 0 2px; border-radius: 2px; color: var(--wc); }
    #chat-messages::-webkit-scrollbar { width: 4px; }
    #chat-messages::-webkit-scrollbar-track { background: transparent; }
    #chat-messages::-webkit-scrollbar-thumb { background: var(--bc); border-radius: 2px; opacity: 0.3; }
    .msg-time { font-size: 0.65rem; opacity: 0.45; line-height: 1; }
    .msg-sender { font-size: 0.7rem; opacity: 0.6; line-height: 1.2; }
    @supports (padding-bottom: env(safe-area-inset-bottom)) {
      .input-area { padding-bottom: calc(8px + env(safe-area-inset-bottom)) !important; }
    }
  </style>
</head>
<body class="bg-base-200">
  <div id="nickname-modal">
    <div class="card bg-base-100 shadow-2xl w-96 max-w-[90%]">
      <div class="card-body p-8">
        <h2 class="card-title text-2xl font-bold">💬 加入聊天室</h2>
        <p class="text-sm opacity-60 mb-2">房间：<span class="badge badge-primary font-mono"><%= roomId %></span></p>
        <input type="text" id="nickname-input" placeholder="输入你的昵称（1-16字符）" maxlength="16" class="input input-bordered input-primary w-full mb-2">
        <p id="nickname-error" class="text-error text-sm mb-2 hidden"></p>
        <button id="nickname-submit" class="btn btn-primary w-full">进入聊天室</button>
      </div>
    </div>
  </div>
  <div id="mute-modal" class="hidden">
    <div class="card bg-base-100 shadow-2xl w-80 max-w-[90%]">
      <div class="card-body p-6">
        <h3 class="card-title text-lg">🔇 禁言用户</h3>
        <p class="text-sm opacity-60 mb-3">选择禁言时长：</p>
        <div class="flex gap-2 mb-4">
          <button class="mute-option btn btn-outline btn-sm flex-1" data-duration="60">1分钟</button>
          <button class="mute-option btn btn-outline btn-sm flex-1" data-duration="300">5分钟</button>
          <button class="mute-option btn btn-outline btn-sm flex-1" data-duration="600">10分钟</button>
        </div>
        <button id="mute-cancel" class="btn btn-ghost w-full">取消</button>
      </div>
    </div>
  </div>
  <div class="h-screen flex flex-col relative main-container">
    <header class="bg-base-100 border-b border-base-300 px-3 py-2 flex items-center justify-between shadow-sm">
      <div class="flex items-center gap-2">
        <h1 class="text-base font-bold truncate max-w-[150px]">💬 <span id="room-name"><%= roomId %></span></h1>
        <span id="connection-status" class="connection-status text-success text-xs">🟢 已连接</span>
      </div>
      <div class="flex items-center gap-1">
        <span id="theme-btn" class="cursor-pointer text-lg select-none" title="切换主题">🌙</span>
        <span id="online-count" class="text-xs opacity-60">0人</span>
        <button id="search-toggle" class="btn btn-ghost btn-xs">🔍</button>
        <button id="change-nickname" class="btn btn-ghost btn-xs">昵称</button>
        <button id="mobile-user-btn" class="btn btn-ghost btn-xs mobile-menu-btn">👥</button>
      </div>
    </header>
    <div id="search-box" class="bg-base-100 border-b border-base-300 px-3 py-2">
      <div class="flex gap-2 items-center">
        <input type="text" id="search-input" placeholder="搜索消息..." class="input input-bordered input-sm flex-1">
        <button id="search-prev" class="btn btn-ghost btn-sm px-2">▲</button>
        <button id="search-next" class="btn btn-ghost btn-sm px-2">▼</button>
        <span id="search-count" class="text-sm opacity-60">0/0</span>
        <button id="search-close" class="btn btn-ghost btn-sm px-2">✕</button>
      </div>
    </div>
    <div class="flex-1 flex overflow-hidden relative">
      <div class="flex-1 flex flex-col bg-base-200 min-w-0">
        <div id="chat-messages" class="flex-1 overflow-y-auto px-3 py-2 flex flex-col gap-0.5"></div>
        <div id="typing-indicator" class="px-3 pb-1 text-xs"></div>
        <div class="bg-base-100 border-t border-base-300 px-3 py-2 relative input-area">
          <div id="emoji-picker-container">
            <emoji-picker></emoji-picker>
          </div>
          <div class="flex gap-2 items-end">
            <button id="emoji-btn" class="btn btn-ghost btn-circle text-xl">😊</button>
            <textarea id="message-input" rows="1" placeholder="输入消息... (@或/w 私聊)" class="textarea textarea-bordered flex-1 resize-none text-sm leading-5" style="max-height: 100px; min-height: 38px;"></textarea>
            <button id="send-btn" class="btn btn-primary btn-sm">发送</button>
          </div>
        </div>
      </div>
      <div class="w-64 bg-base-100 border-l border-base-300 flex flex-col desktop-user-list">
        <div class="px-4 py-3 border-b border-base-200">
          <h3 class="text-sm font-semibold opacity-60 uppercase">在线用户</h3>
        </div>
        <div id="online-users-desktop" class="flex-1 overflow-y-auto p-2 space-y-1"></div>
      </div>
    </div>
  </div>
  <div id="drawer-overlay" class="drawer-overlay"></div>
  <div id="mobile-drawer" class="online-users-drawer">
    <div class="p-3 border-b border-base-200 flex justify-between items-center">
      <h3 class="font-semibold">在线用户</h3>
      <button id="close-drawer" class="btn btn-ghost btn-sm">✕</button>
    </div>
    <div id="online-users-mobile" class="flex-1 overflow-y-auto p-2 space-y-1"></div>
  </div>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/emoji-picker-element@1.21.2/index.js" type="module"></script>
  <script>
    var ROOM_ID = '<%= roomId %>';
  </script>
  <script src="/chatroom.js"></script>
</body>
</html>
