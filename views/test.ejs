<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>通知测试页</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; text-align: center; }
    button { font-size: 18px; padding: 12px 24px; border-radius: 8px; border: none; cursor: pointer; margin: 10px; }
    #startBtn { background: #4CAF50; color: white; }
    #stopBtn { background: #f44336; color: white; }
    #status { margin: 20px 0; padding: 15px; border-radius: 8px; background: #f5f5f5; }
    .success { color: #4CAF50; }
    .error { color: #f44336; }
    #countdown { font-size: 48px; margin: 20px 0; }
    .log { text-align: left; max-height: 200px; overflow-y: auto; background: #f9f9f9; padding: 10px; border-radius: 8px; font-size: 14px; }
    .log-entry { padding: 4px 0; border-bottom: 1px solid #eee; }
    .log-entry:last-child { border-bottom: none; }
  </style>
</head>
<body>
  <h1>🔔 桌面通知测试</h1>
  <p>测试浏览器能否正常推送操作系统通知</p>

  <div id="status">
    <p><strong>通知权限状态：</strong> <span id="permStatus">未检查</span></p>
    <p><strong>浏览器支持：</strong> <span id="supportStatus">未检查</span></p>
  </div>

  <button id="requestBtn">📋 请求通知权限</button>
  <br>
  <button id="startBtn">▶ 开始测试（每秒推送）</button>
  <button id="stopBtn" disabled>⏹ 停止测试</button>

  <div id="countdown"></div>

  <div class="log" id="log">
    <div class="log-entry">等待开始...</div>
  </div>

  <script>
    const permStatus = document.getElementById('permStatus');
    const supportStatus = document.getElementById('supportStatus');
    const requestBtn = document.getElementById('requestBtn');
    const startBtn = document.getElementById('startBtn');
    const stopBtn = document.getElementById('stopBtn');
    const countdown = document.getElementById('countdown');
    const log = document.getElementById('log');

    let intervalId = null;
    let count = 0;

    function addLog(msg, type = '') {
      const entry = document.createElement('div');
      entry.className = 'log-entry';
      if (type) entry.style.color = type === 'success' ? '#4CAF50' : '#f44336';
      const time = new Date().toLocaleTimeString('zh-CN', { hour12: false });
      entry.textContent = `[${time}] ${msg}`;
      log.appendChild(entry);
      log.scrollTop = log.scrollHeight;
    }

    // 检查支持情况
    if ('Notification' in window) {
      supportStatus.textContent = '✅ 支持';
      supportStatus.className = 'success';
      permStatus.textContent = Notification.permission === 'granted' ? '✅ 已授予' : '❌ ' + Notification.permission;
      permStatus.className = Notification.permission === 'granted' ? 'success' : 'error';
    } else {
      supportStatus.textContent = '❌ 不支持';
      supportStatus.className = 'error';
      permStatus.textContent = '浏览器不支持 Notification API';
      permStatus.className = 'error';
    }

    // 请求权限按钮
    requestBtn.addEventListener('click', () => {
      if (!('Notification' in window)) {
        addLog('❌ 浏览器不支持 Notification API', 'error');
        return;
      }
      Notification.requestPermission().then(perm => {
        permStatus.textContent = perm === 'granted' ? '✅ 已授予' : '❌ ' + perm;
        permStatus.className = perm === 'granted' ? 'success' : 'error';
        addLog('权限请求结果: ' + (perm === 'granted' ? '✅ 已授予' : '❌ ' + perm), perm === 'granted' ? 'success' : 'error');
      });
    });

    // 发送一条测试通知
    function sendTestNotification() {
      if (Notification.permission !== 'granted') {
        addLog('❌ 权限未授予，无法发送通知', 'error');
        return false;
      }
      try {
        const notif = new Notification('🔔 测试通知 #' + count, {
          body: '这是第 ' + count + ' 条测试通知，发送时间: ' + new Date().toLocaleTimeString('zh-CN', { hour12: false }),
          icon: ''
        });
        notif.onclick = () => {
          window.focus();
          addLog('✅ 通知 #' + count + ' 被点击', 'success');
        };
        addLog('✅ 通知 #' + count + ' 已发送', 'success');
        count++;
        countdown.textContent = count;
        return true;
      } catch (e) {
        addLog('❌ 通知发送失败: ' + e.message, 'error');
        return false;
      }
    }

    // 开始测试
    startBtn.addEventListener('click', () => {
      if (Notification.permission !== 'granted') {
        addLog('❌ 请先点击"请求通知权限"按钮', 'error');
        return;
      }
      if (intervalId) return;
      count = 0;
      countdown.textContent = '0';
      addLog('▶ 开始测试...');
      // 立即发送一条
      sendTestNotification();
      // 每秒发送一条
      intervalId = setInterval(() => {
        sendTestNotification();
      }, 1000);
      startBtn.disabled = true;
      stopBtn.disabled = false;
    });

    // 停止测试
    stopBtn.addEventListener('click', () => {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
      startBtn.disabled = false;
      stopBtn.disabled = true;
      addLog('⏹ 测试已停止，共发送 ' + count + ' 条通知');
    });
  </script>
</body>
</html>
